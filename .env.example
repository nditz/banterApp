# Supabase (frontend — Next.js public vars only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL used for OAuth redirects (must match Supabase Auth → URL configuration)
# Production: https://balltakes.com
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API — proxy mode (recommended for production)
# Production: API_PROXY_URL=https://api.balltakes.com, leave NEXT_PUBLIC_API_URL empty
# Local dev:  API_PROXY_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=
API_PROXY_URL=http://localhost:5000

# In Supabase: enable Google provider + add redirect URLs:
#   http://localhost:3000/auth/callback          (local)
#   https://balltakes.com/auth/callback          (production)
#   https://www.balltakes.com/auth/callback      (production www)

# Cloudflare Turnstile (frontend widget — public site key only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Backend secrets → NOT here. Use:
#   backend/BanterApp.Api/appsettings.Development.json  (local, gitignored)
#   Render environment variables                        (production deploy)
# See docs/BACKEND-CONFIGURATION.md and DEPLOYMENT.md
# ---------------------------------------------------------------------------

# Prisma (frontend only — if using Prisma CLI)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
