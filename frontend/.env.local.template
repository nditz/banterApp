# Ball Takes — frontend environment variables (production template)
# Copy to frontend/.env.local for local overrides, or set in Vercel Dashboard.
# Never commit real secrets.

# --- Supabase (from Vercel Supabase integration or Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_ANON_KEY]

# --- Site URL (OAuth redirects — must match Supabase Auth URL configuration) ---
NEXT_PUBLIC_SITE_URL=https://balltakes.com
NEXT_PUBLIC_APP_URL=https://balltakes.com

# --- Backend API (proxy mode — recommended for production) ---
# Browser calls /api-backend/* which Vercel rewrites to the Render API.
API_PROXY_URL=https://api.balltakes.com
NEXT_PUBLIC_API_URL=

# --- Cloudflare Turnstile (public site key only) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=[YOUR_TURNSTILE_SITE_KEY]

# --- Local development overrides (uncomment when testing locally) ---
# API_PROXY_URL=http://localhost:5000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
