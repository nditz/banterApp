# BanterApp API — Render production environment variables
# Copy values into Render Dashboard → Environment (never commit real secrets).
#
# ASP.NET Core maps double-underscore keys to config sections:
#   Supabase__JwtSecret  →  Supabase:JwtSecret
#
# Supabase PostgreSQL: use the SESSION pooler (port 5432) for EF Core.
# URL-encode special characters in passwords (/ → %2F, * → %2A).

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
PORT=[AUTO_SET_BY_RENDER]

# --- CORS (comma-separated; production only — no localhost) ---
ALLOWED_ORIGINS=https://balltakes.com,https://www.balltakes.com

# Alternative ASP.NET array syntax (either ALLOWED_ORIGINS or these):
# Cors__AllowedOrigins__0=https://balltakes.com
# Cors__AllowedOrigins__1=https://www.balltakes.com

# --- Database (Supabase PostgreSQL session pooler, port 5432) ---
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Alternative ASP.NET key (same value as DATABASE_URL):
# ConnectionStrings__DefaultConnection=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional transaction pooler (port 6543) for reference only:
# Database__TransactionUrl=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Supabase Auth ---
Supabase__Url=https://[YOUR_PROJECT_REF].supabase.co
Supabase__JwtSecret=[YOUR_JWT_SECRET_FROM_SUPABASE_DASHBOARD]
Supabase__AnonKey=[YOUR_ANON_KEY]
Supabase__ServiceRoleKey=[YOUR_SERVICE_ROLE_KEY]

# --- Security ---
Security__SessionSecret=[YOUR_32_PLUS_CHAR_RANDOM_STRING]
Security__TurnstileSecretKey=[YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY]

# --- AI (required when Ai__Provider=openai) ---
Ai__Provider=openai
Ai__ApiKey=[YOUR_OPENAI_API_KEY]
Ai__Model=gpt-4o-mini
Ai__Enabled=true

# --- YouTube (required in production) ---
YouTube__ApiKey=[YOUR_YOUTUBE_DATA_API_KEY]

# --- Admin ---
Admin__AllowedEmails__0=[YOUR_ADMIN_EMAIL]
Admin__ExposeErrorDetail=false

# --- Legal (required in production) ---
Legal__DisclaimerText=[YOUR_DISCLAIMER_TEXT]
Legal__TermsUrl=https://balltakes.com/terms
Legal__PrivacyPolicyUrl=https://balltakes.com/privacy

# --- Privacy / consent (optional; defaults live in appsettings.json) ---
# ConsentVersion MUST match CONSENT_VERSION in frontend/src/lib/consent.ts.
# If they differ, every stored choice reads as stale and the banner reappears
# on every page load. Bump both in the same commit.
Privacy__ConsentVersion=2026-08-25
# Environment kill switches. Setting either to false denies that category for
# everyone regardless of what a user has consented to.
Privacy__AnalyticsEnabled=true
Privacy__MarketingCategoryEnabled=true

# --- Analytics retention (optional; consumed by analytics.retention.cleanup) ---
Analytics__RawEventRetentionDays=180
Analytics__RetentionDeleteBatchSize=5000

# --- Optional tuning ---
BackgroundJobs__Enabled=true
SportsData__Provider=mock
Operations__BackupsConfigured=true
GIT_COMMIT=[YOUR_DEPLOY_SHA]

# --- Optional third-party APIs ---
# SportsData__Provider=apifootball
# SportsData__ApiKey=[YOUR_API_FOOTBALL_KEY]
# Sportmonks__Token=[YOUR_SPORTMONKS_TOKEN]
# FootballData__Token=[YOUR_FOOTBALL_DATA_TOKEN]
# News__ApiKey=[YOUR_NEWS_API_KEY]
