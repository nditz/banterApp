  "openai": {
    "enabled": true,
    "model": "gpt-5",
    "temperature": 0.8,
    "max_output_tokens": 1800,
    "pipeline_roles": {
      "extractor": {
        "purpose": "Extract structured pundit opinions, predictions, claims, source metadata, and quotes from source content.",
        "must_not_invent_quotes": true,
        "must_flag_uncertainty": true
      },
      "banter_engine": {
        "purpose": "Transform grounded football facts into Gen Z football banter, meme captions, reactions, and shareable feed content.",
        "must_preserve_source_attribution": true,
        "must_not_create_fake_claims": true
      }
    }
  },
  "content_rules": {
    "quote_policy": {
      "allow_short_quotes": true,
      "avoid_long_copyrighted_excerpts": true,
      "always_include_source_url": true,
      "always_label_statement_type": true,
      "statement_types": [
        "direct_quote",
        "paraphrase",
        "ai_summary",
        "inferred_prediction"
      ]
    },
    "safety": {
      "no_hate_speech": true,
      "no_harassment": true,
      "no_fake_endorsements": true,
      "no_claimed_affiliation_without_permission": true,
      "keep_banter_football_focused": true
    }
  },
  "banter": {
    "default_intensity": 7,
    "allowed_intensity_range": [
      1,
      10
    ],
    "tone": [
      "fun",
      "gen_z",
      "football_twitter",
      "group_chat",
      "cheeky",
      "meme_page",
      "banter"
    ],
    "output_shape": {
      "headline": "string",
      "banter_summary": "string",
      "meme_reactions": "array",
      "gif_suggestions": "array",
      "fan_reactions": "array",
      "confidence": "number",
      "source_name": "string",
      "source_url": "string",
      "pundit_name": "string",
      "prediction": "string",
      "statement_type": "direct_quote | paraphrase | ai_summary | inferred_prediction"
    }
  },
  "review_rules": {
    "needs_human_review_when": [
      "pundit_name_missing",
      "source_text_incomplete",
      "quote_is_inferred_not_direct",
      "confidence_below_0_7",
      "multiple_speakers_mixed",
      "prediction_is_vague",
      "source_url_missing"
    ]
  }
}