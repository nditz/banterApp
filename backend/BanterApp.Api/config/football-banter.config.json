  "version": "1.0.0",
  "feature": "football_banter_engine",
  "description": "Configuration for RSS, YouTube, OpenAI extraction, and football banter generation.",
  "sources": {
    "youtube": {
      "enabled": true,
      "api_base_url": "https://www.googleapis.com/youtube/v3",
      "search_terms": [
        "Premier League 2026/27 predictions pundits",
        "football pundits predictions",
        "BBC Sport Premier League predictions",
        "Sky Sports Premier League predictions",
        "ESPN FC predictions",
        "Guardian Football Premier League analysis"
      ],
      "max_results_per_search": 25,
      "sync_interval_minutes": 180,
      "transcripts": {
        "prefer_official_captions": true,
        "allow_fallback_to_description": true,
        "allow_fallback_to_openai_enrichment": true,
        "requires_source_attribution": true
      }
    },
    "rss": {
      "enabled": true,
      "sync_interval_minutes": 30,
      "dedupe_strategy": [
        "guid",
        "link",
        "content_hash"
      ],
