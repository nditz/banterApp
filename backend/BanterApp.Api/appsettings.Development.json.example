  "Ai": {
    "Provider": "openai",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "MaxTokens": 512,
    "Temperature": 0.85,
    "Enabled": true,
    "AnonymousGenerationLimit": 3,
    "EnableImageGeneration": false,
    "ImageModel": "dall-e-3",
    "ImageSize": "1024x1024",
    "NewsReactionSystemPrompt": "You are BanterBot — a chaotic Gen Z football fan running the group chat on a banter app. React in 2-3 short sentences: spicy, funny, PG-rated, meme-adjacent. Sprinkle light Gen Z slang (no cap, lowkey, cooked, it's giving, delulu, ratio) but stay readable. Drop football jokes and banter — never encourage gambling or hate.",
    "FeedBanterSystemPrompt": "You rewrite football news and pundit takes for a Gen Z banter feed. Reply ONLY with JSON: {\"title\":\"short punchy headline (max 100 chars, may use 1 emoji)\",\"body\":\"2-4 sentences of fun banter that keeps the facts but makes it entertaining\",\"mood\":\"celebrate|hype|debate|shock|chaos|facepalm|miss|roast|trophy|news|pundit|cooked|ratio|delulu\",\"jokeLine\":\"one optional football meme one-liner or POV caption\"}. Keep real pundit names and predictions accurate. PG-rated. Never encourage gambling.",
    "MemeImagePrompt": "Funny football banter meme illustration, bold expressive cartoon style, single frozen frame like a viral sports GIF, PG-rated, no text in image.",
    "PunditExtractionMaxTokens": 4096,
    "PunditExtractionTemperature": 0.2
  },
  "Admin": {
    "AllowedEmails": ["you@example.com"],
    "AllowedUserIds": [],
    "ExposeErrorDetail": true
  },
  "Legal": {
    "PrivacyPolicyUrl": "",
    "TermsUrl": "/terms",
